config DEFY_RP2040_FACTORY_HANDOFF
    bool "Defy RP2040 factory watchdog handoff"
    default y
    depends on SOC_RP2040 && FLASH_LOAD_OFFSET = 0x6100
    select SOC_RESET_HOOK
    select INIT_ARCH_HW_AT_BOOT
    help
      For an image that Dygma's RP2040 bootloader starts at 0x6100. The
      bootloader leaves its watchdog running, which the reset hook stops
      before Zephyr starts. With DEFY_FATAL_RECOVERY the hook also runs
      defy_fatal_recovery_boot(), which counts quick faults.

config DEFY_RP2040_USB_CLOCKS_OFF
    bool "Defy RP2040 USB PLL off"
    default y
    depends on BOARD_DEFY_LEFT || BOARD_DEFY_RIGHT
    depends on CLOCK_CONTROL_RPI_PICO
    depends on !USB_DEVICE_STACK && !USB_DEVICE_STACK_NEXT && !ADC && !COUNTER && !RTC
    help
      Turns off the USB PLL, which runs at 48 MHz, and the USB, ADC and
      RTC clocks it drives, after Zephyr's clock driver has started them.
      The halves use none of them, so this saves power while a half is
      awake.
