+/* Defy: scanning that recovers on its own. It replaces ZMK's stop_scanning()
+ * and start_scanning(): dropped reports restart the scan, failed scan
+ * operations retry from the work queue, connection attempts time out, and
+ * a half rejected for an identity conflict is held off. See
+ * docs/ble-input-recovery.md in zmk-defy-wireless. */
+
+/* Set while a scan start or stop is in progress, so the two never overlap. */
+static atomic_t scan_operation;
+
+/* BT_LE_SCAN_PASSIVE filters duplicates, so the controller reports each
+ * address once per scan. After a report is dropped, start_scanning()
+ * restarts a running scan so that half is reported again. */
+static bool scan_restart;
+
+static void scan_retry_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    start_scanning();
+}
+
+static K_WORK_DELAYABLE_DEFINE(scan_retry_work, scan_retry_handler);
+static K_WORK_DELAYABLE_DEFINE(hold_off_work, scan_retry_handler);
+
+#define SCAN_RETRY_MS 500
+
+/* Starts scanning again SCAN_RETRY_MS later, from the work queue rather than
+ * the callback where a scan operation just failed. */
+static void retry_scanning(void) {
+    if (is_enabled) {
+        k_work_reschedule(&scan_retry_work, K_MSEC(SCAN_RETRY_MS));
+    }
+}
+
+/* Drops the report of a half that is held off and looks again when the
+ * hold ends, so a persistent identity conflict cannot loop reconnects. */
+static bool hold_connection(int slot) {
+    int64_t wait = defy_hybrid_ble_hold_off(slot);
+    if (wait <= 0) {
+        return false;
+    }
+    scan_restart = true;
+    k_work_schedule(&hold_off_work, K_MSEC(wait));
+    return true;
+}
+
+/* With controller privacy off, the controller has no resolving list. Once
+ * any bond has shared an identity key, as a Mac's does, Zephyr makes every
+ * create wait in the host for the target's next advertisement, with no
+ * timeout. The halves' fixed addresses need no resolving, but their creates
+ * wait the same way. start_scanning() holds off while any attempt is
+ * pending, so one half that stops advertising would block the other. Cancel
+ * attempts that outlast the half's advertising interval plus Zephyr's 3 s
+ * initiation timeout; the cancellation reaches split_central_connected()
+ * with an error, which releases the slot and retries. */
+#define SPLIT_CONNECT_TIMEOUT_MS 5000
+#define SPLIT_CONNECT_CANCEL_RETRY_MS 1000
+
+static void connect_timeout_handler(struct k_work *work);
+
+static K_WORK_DELAYABLE_DEFINE(connect_timeout_work, connect_timeout_handler);
+
+static void connect_timeout_handler(struct k_work *work) {
+    ARG_UNUSED(work);
+    for (int i = 0; i < CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS; i++) {
+        struct bt_conn *conn = peripherals[i].conn;
+        struct bt_conn_info info;
+
+        if (peripherals[i].state != PERIPHERAL_SLOT_STATE_CONNECTING || conn == NULL ||
+            bt_conn_get_info(conn, &info) < 0 || info.state != BT_CONN_STATE_CONNECTING) {
+            continue;
+        }
+
+        LOG_WRN("Cancelling split connection attempt after %d ms", SPLIT_CONNECT_TIMEOUT_MS);
+        int err = bt_conn_disconnect(conn, BT_HCI_ERR_UNKNOWN_CONN_ID);
+        if (err < 0 && peripherals[i].state == PERIPHERAL_SLOT_STATE_CONNECTING &&
+            peripherals[i].conn == conn) {
+            LOG_ERR("Cannot cancel split connection attempt (err %d)", err);
+            k_work_reschedule(&connect_timeout_work, K_MSEC(SPLIT_CONNECT_CANCEL_RETRY_MS));
+        }
+    }
+}
+
+static int create_connection(const bt_addr_le_t *addr, const struct bt_le_conn_param *param,
+                             struct bt_conn **conn) {
+    int err = bt_conn_le_create(addr, BT_CONN_LE_CREATE_CONN, param, conn);
+    if (err == 0) {
+        k_work_reschedule(&connect_timeout_work, K_MSEC(SPLIT_CONNECT_TIMEOUT_MS));
+        if (!is_enabled && *conn != NULL) {
+            /* Disabled while the create was in flight, too late for
+             * split_central_bt_set_enabled() to cancel it. */
+            bt_conn_disconnect(*conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+        }
+    }
+    return err;
+}
+
 static int stop_scanning(void) {
     LOG_DBG("Stopping peripheral scanning");
+    k_work_cancel_delayable(&scan_retry_work);
+    if (!atomic_cas(&scan_operation, 0, 1)) {
+        return -EBUSY;
+    }
+
     is_scanning = false;
 
     int err = bt_le_scan_stop();
+    atomic_clear(&scan_operation);
     if (err < 0) {
         LOG_ERR("Stop LE scan failed (err %d)", err);
-        return err;
     }
 
-    return 0;
+    return err;
 }
 
