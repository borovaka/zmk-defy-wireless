# SysTick runs from clk_sys, 125 MHz.
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=125000000

CONFIG_RESET=y
CONFIG_CLOCK_CONTROL=y
CONFIG_GPIO=y
CONFIG_SPI=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_ZMK_DBL_TAP_BOOTLOADER=n

# Settings storage
CONFIG_SETTINGS=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_BLE=y
# ZMK's Bluetooth split sorts after the module's hybrid (0) and cable (10)
# transports.
CONFIG_ZMK_SPLIT_BLE_PRIORITY=20

# The halves report their batteries through the module's own telemetry.
CONFIG_ZMK_BATTERY_REPORTING=n

# The 1 KiB default main stack overflows. STACK_SENTINEL turns an overflow into
# a fatal error, which the half shows on its LEDs.
CONFIG_MAIN_STACK_SIZE=4096
CONFIG_STACK_SENTINEL=y

# ZMK's notify thread also disconnects the Neuron before dormant sleep, which
# needs more than the 756-byte default.
CONFIG_ZMK_SPLIT_BLE_PERIPHERAL_STACK_SIZE=1024
