/* The right half's cable node, which gives its side. */
&spi0 {
    version_half: wired@0 {
        compatible = "dygma,defy-wired-peripheral";
        reg = <0>;
        spi-max-frequency = <1000000>;
        half-id = <1>;
    };
};

/* The seal partition at 0x5000, as on the halves. */
&boot_partition {
    reg = <0x0 0x5000>;
};

&flash0 {
    partitions {
        factory_seal: partition@5000 {
            reg = <0x5000 0x1100>;
        };
    };
};
