/* SPDX-License-Identifier: MIT */

/ {
    defy_leds: test-leds {
        compatible = "vnd,defy-test-leds";
        chain-length = <64>;
    };
    key_leds: test-keys {
        compatible = "vnd,defy-test-leds";
        chain-length = <35>;
    };
};

/* The half's side, which picks the profiles its chooser shows: the left half. */
&spi0 {
    wired@0 {
        compatible = "dygma,defy-wired-peripheral";
        reg = <0>;
        spi-max-frequency = <1000000>;
        half-id = <0>;
    };
};
