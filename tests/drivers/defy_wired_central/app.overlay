/* SPDX-License-Identifier: MIT */

/ {
    defy_cables: cables {
        compatible = "dygma,defy-neuron-cables";
        spi-ports = <&test_spi0 &test_spi1>;
        run-gpios = <&gpio0 29 0>, <&gpio0 28 0>;
        i2c-bus = <&i2c0>;
    };
    test_spi0: test-spi0 {
        compatible = "dygma,wired-test-spi";
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";
    };
    test_spi1: test-spi1 {
        compatible = "dygma,wired-test-spi";
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";
    };
};
